---
// Preguntas frecuentes: banda clara con el titular fijo a la izquierda en escritorio y el acordeón (<details>, sin
// JavaScript) a la derecha. `preguntas` [{pregunta, respuesta}]. Base.astro añade el JSON-LD FAQPage.
import { seccion, parrafos } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const lista = (s?.preguntas ?? []).filter((p) => p?.pregunta);
---

{
  s && (
    <Seccion id={Astro.props.id} banda="claro">
      <div class="preguntas-rejilla">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
        {lista.length > 0 && (
          <div class="acordeon">
            {lista.map((p) => (
              <details>
                <summary>{p.pregunta}</summary>
                {parrafos(String(p.respuesta ?? '')).map((t) => <p>{t}</p>)}
              </details>
            ))}
          </div>
        )}
      </div>
    </Seccion>
  )
}
