---
// Pie a todo el ancho en bosque hondo: el nombre enorme en serifa y el eslogan; debajo, tres columnas (contacto, menú,
// horario y redes) y la línea legal. En el móvil, una barra fija abajo con «Llamar» y el botón de reservar
// (site.yaml → boton_cabecera; sin él, WhatsApp) para tenerlos siempre a mano.
// «Web creada con NoExpertise» se muestra si site.yaml → marca_pie no es false.
import { site, tel, mapa, whatsapp, nueva } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'ventana' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const reservar = site.boton_cabecera?.url
  ? site.boton_cabecera
  : c.whatsapp
    ? { texto: 'WhatsApp', url: whatsapp(c.whatsapp, `Hola, os escribo desde la web de ${site.nombre}`) }
    : null;
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor pie-gran-nombre">
    <p aria-hidden="true">{site.nombre}</p>
    {site.eslogan && <p class="pie-gran-eslogan">{site.eslogan}</p>}
  </div>
  <div class="contenedor pie-columnas">
    {
      (c.direccion || c.telefono || c.email || c.whatsapp) && (
        <div>
          <p class="pie-titulo">Contacto</p>
          <ul class="pie-lista">
            {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
            {c.telefono && <li><a href={tel(c.telefono)}>{c.telefono}</a></li>}
            {c.whatsapp && <li><a href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">WhatsApp {c.whatsapp}</a></li>}
            {c.email && <li><a href={`mailto:${c.email}`} class="break-all">{c.email}</a></li>}
          </ul>
        </div>
      )
    }
    {
      site.menu.length > 0 && (
        <nav aria-label="Menú del pie">
          <p class="pie-titulo">En la web</p>
          <ul class="pie-lista">
            {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
          </ul>
        </nav>
      )
    }
    {
      (c.horario || redes.length > 0) && (
        <div>
          {c.horario && (
            <>
              <p class="pie-titulo">Horario</p>
              <p class="mb-6">{c.horario}</p>
            </>
          )}
          {redes.length > 0 && (
            <ul class="pie-redes flex gap-3">
              {redes.map(([red, url]) => (
                <li>
                  <a href={url} rel="noopener" target="_blank" aria-label={red}>
                    <Icono nombre={red} tam={20} />
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      )
    }
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
  {
    (c.telefono || reservar) && (
      <nav class="barra-movil" aria-label="Llamar o reservar">
        {c.telefono && (
          <a class="btn-sec" href={tel(c.telefono)}>
            <Icono nombre="telefono" tam={18} /> Llamar
          </a>
        )}
        {reservar && <a class="btn" href={reservar.url} {...nueva(reservar.url)}>{reservar.texto}</a>}
      </nav>
    )
  }
</footer>
